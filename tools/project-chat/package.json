{
  "name": "project-chat",
  "productName": "Agent Chat",
  "version": "0.3.5",
  "description": "Local AI assistant chat and nightly agent report inbox",
  "author": "Block Concepts LLC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blockconcepts.projectchat",
    "productName": "Agent Chat",
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "public/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AgentChat-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
