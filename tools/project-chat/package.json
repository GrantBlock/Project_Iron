{
  "name": "project-chat",
  "productName": "Project Chat",
  "version": "0.2.1",
  "description": "Local AI assistant chat and nightly agent report inbox",
  "author": "Block Concepts LLC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "engines": { "node": ">=18" },
  "private": true,
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blockconcepts.projectchat",
    "productName": "Project Chat",
    "files": ["main.js", "server.js", "public/**", "build/icon.png"],
    "win": { "target": "portable", "icon": "build/icon.ico", "signAndEditExecutable": false },
    "portable": { "artifactName": "ProjectChat-${version}.exe" },
    "directories": { "output": "dist" }
  }
}
