{
  "name": "collide",
  "productName": "Collide",
  "private": true,
  "version": "0.1.0",
  "description": "Collide",
  "author": "Block Concepts LLC",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm build:electron",
    "build:electron": "vite build -c vite.electron.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:electron": "pnpm build && playwright test -c playwright.electron.config.ts",
    "ref": "node scripts/ref.mjs",
    "ref:prototype": "node scripts/ref.mjs prototype",
    "ref:app": "node scripts/ref.mjs app",
    "lint": "eslint .",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist": "pnpm build && electron-builder --win --x64",
    "dist:portable": "pnpm build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "konva": "^10.9.1",
    "lucide-static": "0.460.0",
    "markdown-it": "^14.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.blockconcepts.collide",
    "productName": "Collide",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/**",
      "!node_modules"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Collide-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    },
    "copyright": "Copyright © 2026 Block Concepts LLC",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Collide",
      "uninstallDisplayName": "Collide",
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Collide-Setup-${version}.exe"
    },
    "publish": null
  }
}
